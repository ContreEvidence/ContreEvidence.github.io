{
  "ci": {
    "collect": {
      "staticDistDir": "./",
      "numberOfRuns": 2,
      "url": [
        "http://localhost/index.html",
        "http://localhost/parcours-de-vie.html",
        "http://localhost/mon-espace.html",
        "http://localhost/simulateur-cout-trajet-emploi.html",
        "http://localhost/outil-repartir-grosse-somme.html",
        "http://localhost/dossiers/acheter-ou-louer-si-on-risque-demenager.html"
      ]
    },
    "assert": {
      "includePassedAssertions": true,
      "assertions": {
        "categories:performance": ["warn", {"minScore": 0.70, "aggregationMethod": "median"}],
        "categories:best-practices": ["warn", {"minScore": 0.85, "aggregationMethod": "median"}],
        "categories:seo": ["warn", {"minScore": 0.85, "aggregationMethod": "median"}],
        "http-status-code": ["error", {"minScore": 1}],
        "errors-in-console": ["error", {"minScore": 1}],
        "viewport": ["error", {"minScore": 1}],
        "total-byte-weight": ["warn", {"maxNumericValue": 5000000, "aggregationMethod": "median"}],
        "resource-summary:script:size": ["warn", {"maxNumericValue": 750000, "aggregationMethod": "median"}],
        "resource-summary:image:size": ["warn", {"maxNumericValue": 3000000, "aggregationMethod": "median"}]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-reports"
    }
  }
}
